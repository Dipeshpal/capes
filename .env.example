# pulse-mcp environment.
# On Vercel: set these as Environment Variables (or let scripts/pulse.mjs do it). Contributors: copy to .env for local runs.

# Server key: protects /mcp and the dashboard. At least 24 characters; 32+ recommended.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_API_KEY=your_secure_api_key_here

# Discord bot token (optional): https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Apify token for X/Twitter search (optional): https://console.apify.com/settings/integrations
APIFY_TOKEN=your_apify_token_here

# Gmail (optional). Needs 2-Step Verification on the account, then create an app password at
# https://myaccount.google.com/apppasswords  (16 characters; spaces are ignored)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# --- Advanced, NOT needed for normal use: Redis for dashboard switches ------------------------------------
# Only if you want to flip switches on the dashboard without redeploying (and keep a durable activity log). Add it with:
#   vercel integration add upstash
# which sets KV_REST_API_URL and KV_REST_API_TOKEN for you. (UPSTASH_REDIS_REST_URL and
# UPSTASH_REDIS_REST_TOKEN are accepted too.) Without it the dashboard is read only.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Dashboard sign-in length in hours (1-168, default 8). After that you sign in again; the key never needs scheduled rotation.
# PULSE_SESSION_HOURS=8

# --- Restrict what clients may do (optional, no database needed) ----------------------------------------------
# These always apply and cannot be undone from the dashboard.
# PULSE_READ_ONLY=1
# PULSE_DISABLED_CONNECTORS=discord,apify
# PULSE_DISABLED_TOOLS=gmail_trash,discord_delete_channel

# --- Advanced (optional) -------------------------------------------------------------------------------
# Use a different Apify actor for X/Twitter search (owner~name)
# APIFY_TWEET_ACTOR=apidojo~tweet-scraper
# Where the dashboard "Guide" links point (set this if you forked the repo)
# PULSE_REPO_URL=https://github.com/you/your-fork
