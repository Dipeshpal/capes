# pulse-mcp environment.
# Local runs: copy this file to .env. On Vercel: set these as Environment Variables (or use scripts/pulse.mjs).

# Protects your server. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=your_secure_api_key_here

# Discord bot token (optional): https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Apify token for X/Twitter search (optional): https://console.apify.com/settings/integrations
APIFY_TOKEN=your_apify_token_here
