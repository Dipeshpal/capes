# research-tools-mcp environment. Copy to .env for local runs; on Vercel set these as Environment Variables.
# Copy this file to .env and fill in your own values

# Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Apify API Token (for Twitter/X scraping)
# Get from: https://apify.com/account/integrations/api
APIFY_TOKEN=your_apify_api_token_here

# Research API Key (for protecting your MCP server)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
RESEARCH_API_KEY=your_secure_api_key_here
